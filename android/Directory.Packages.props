<Project>
  <!-- Central package versions for android/ (the root Directory.Packages.props is not inherited). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- App -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.110" />
    <!-- UI (same version as the web app) -->
    <PackageVersion Include="MudBlazor" Version="9.11.0" />
    <!-- Persistence (same versions as the web app) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <!-- Documents (same versions as the web app) -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="AngleSharp" Version="1.8.3" />
    <!-- PDF on Android (QuestPDF has no Android binaries): pure .NET, MIT -->
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp (up to 6.5.0) asks for System.Security.Cryptography.Pkcs >= 8.0.1, flagged by GHSA-846f-f764-76mx and
         GHSA-2fmv-rv2c-59x7; 10.0.13 is a patched version, referenced directly by the Core library -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Google authorization on Android (Play services AuthorizationClient, play-services-auth 22.0.0); binding: MIT -->
    <PackageVersion Include="Xamarin.GooglePlayServices.Auth" Version="122.0.0" />
    <!-- Play services raises AndroidX Fragment, Collection and Lifecycle above the versions MAUI 10.0.110 references; the Kotlin
         extension packages MAUI brings only accept the older ones (NU1608), so they are aligned with the resolved versions. -->
    <PackageVersion Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
    <!-- Calendar files (.ics), same version as the web app -->
    <PackageVersion Include="Ical.Net" Version="5.2.3" />
    <!-- HTTP and configuration -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="bunit" Version="2.11.3" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>
</Project>
