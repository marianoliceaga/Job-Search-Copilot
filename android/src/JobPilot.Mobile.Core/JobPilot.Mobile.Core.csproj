<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- UI and services of the Android app on plain net10.0, so they are testable without the Android toolchain.
       Must not reference MAUI: platform services (secure storage, file picker, sharing) go behind interfaces
       implemented in JobPilot.Mobile (enforced by a test). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JobPilot.Mobile.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\JobPilot.Domain\JobPilot.Domain.csproj" />
  </ItemGroup>

  <!-- Shared with the web app, read-only: the same versioned prompts and the same model, parameter and price defaults. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\src\JobPilot.Web\Prompts\*.md" Link="Shared\Prompts\%(Filename)%(Extension)" LogicalName="Prompts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\src\JobPilot.Web\appsettings.json" Link="Shared\web-appsettings.json" LogicalName="web-appsettings.json" />
  </ItemGroup>

</Project>
