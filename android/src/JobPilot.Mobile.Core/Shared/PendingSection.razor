@* Placeholder for a section that becomes functional in a later Android phase. *@

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">@Section.Title</MudText>
<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
    Esta sección se implementa en la fase @Section.Phase de la app para Android.
</MudAlert>
<MudText>@Section.Description</MudText>

@ChildContent

@code {
    [Parameter, EditorRequired]
    public required AppSection Section { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
