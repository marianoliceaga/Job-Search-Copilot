@page "/outreach"

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">@AppSections.Outreach.Title</MudText>
<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3" Dense="true">
    JobSearch Copilot no envía mensajes ni accede a LinkedIn: prepara borradores para que los revises, los copies o compartas y los envíes vos.
</MudAlert>

<MudTabs Outlined="true" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-3" MinimumTabWidth="0px">
    <MudTabPanel Text="Mensajes">
        <OutreachMessagesPanel PostingId="PostingId" CompanyId="CompanyId" />
    </MudTabPanel>
    <MudTabPanel Text="Perfil de LinkedIn">
        <LinkedInReviewPanel />
    </MudTabPanel>
</MudTabs>

@code {
    [SupplyParameterFromQuery(Name = "oferta")]
    public Guid? PostingId { get; set; }

    [SupplyParameterFromQuery(Name = "empresa")]
    public Guid? CompanyId { get; set; }
}
