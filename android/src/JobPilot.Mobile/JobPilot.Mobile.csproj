<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Android host of the app: BlazorWebView + platform services. UI and logic live in JobPilot.Mobile.Core. -->

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>JobPilot.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <!-- Blazor handles CSS, not MAUI -->
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>JobSearch Copilot</ApplicationTitle>
    <!-- Permanent: Android only updates an installed app with the same id and signing key. -->
    <ApplicationId>com.vidi.jobpilot</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <!-- CI passes the run number so every signed build installs as an update. -->
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Android 8.0 (API 26) or later -->
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Release builds produce an APK (installed directly, not through Google Play). Signing properties come from the
       command line or environment (see android/README.md); the keystore is never in the repo. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidPackageFormats>apk</AndroidPackageFormats>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#594AE2" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#594AE2" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Xamarin.GooglePlayServices.Auth" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JobPilot.Mobile.Core\JobPilot.Mobile.Core.csproj" />
  </ItemGroup>

</Project>
