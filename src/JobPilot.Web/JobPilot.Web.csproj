<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>jobpilot-web-local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Ical.Net" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JobPilot.Domain\JobPilot.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Prompts\*.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Seed\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Seed\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JobPilot.Web.Tests" />
  </ItemGroup>

</Project>
