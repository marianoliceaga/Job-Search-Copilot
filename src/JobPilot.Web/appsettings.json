{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "JobPilot": {
    "Port": 5080,
    "DataDirectory": ""
  },
  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/",
    "StructuredOutputMode": "ResponseFormat",
    "MaxRetryAttempts": 3,
    "RetryBaseDelaySeconds": 2,
    "AttemptTimeoutSeconds": 120,
    "TotalTimeoutSeconds": 360
  },
  "Llm": {
    "DefaultModel": "gemini-3.8-flash",
    "MaxInvalidOutputRetries": 1,
    "UseCases": {
      "connection-test": {
        "ThinkingLevel": "MINIMAL",
        "MaxOutputTokens": 1024
      },
      "cv-import": {
        "ThinkingLevel": "LOW",
        "MaxOutputTokens": 32768
      },
      "job-extraction": {
        "Model": "gemini-3.5-flash-lite",
        "ThinkingLevel": "LOW",
        "MaxOutputTokens": 4096
      },
      "job-analysis": {
        "ThinkingLevel": "MEDIUM",
        "MaxOutputTokens": 16384
      }
    },
    "Pricing": {
      "gemini-3.8-flash": {
        "InputPerMillionUsd": 0.75,
        "OutputPerMillionUsd": 3.75
      },
      "gemini-3.5-flash": {
        "InputPerMillionUsd": 1.5,
        "OutputPerMillionUsd": 9.0
      },
      "gemini-3.5-flash-lite": {
        "InputPerMillionUsd": 0.3,
        "OutputPerMillionUsd": 2.5
      }
    }
  },
  "JobSources": {
    "UserAgent": "JobPilot/1.0 (personal job search; +https://github.com/marianoliceaga/MiFuturoTrabajoCosechador)",
    "Sources": {
      "remotive": {
        "Urls": [
          "https://remotive.com/api/remote-jobs?category=software-dev"
        ],
        "MinIntervalMinutes": 360
      },
      "remoteok": {
        "Urls": [
          "https://remoteok.com/api"
        ],
        "MinIntervalMinutes": 60
      },
      "himalayas": {
        "Urls": [
          "https://himalayas.app/jobs/api/search?q="
        ],
        "MinIntervalMinutes": 360,
        "MaxKeywordQueries": 3
      },
      "jobicy": {
        "Urls": [
          "https://jobicy.com/api/v2/remote-jobs?count=50&industry=dev"
        ],
        "MinIntervalMinutes": 60
      },
      "weworkremotely": {
        "Urls": [
          "https://weworkremotely.com/categories/remote-back-end-programming-jobs.rss",
          "https://weworkremotely.com/categories/remote-full-stack-programming-jobs.rss"
        ],
        "MinIntervalMinutes": 60
      },
      "greenhouse": {
        "Urls": [
          "https://boards-api.greenhouse.io/v1/boards/{board}/jobs?content=true"
        ],
        "MinIntervalMinutes": 60
      },
      "lever": {
        "Urls": [
          "https://api.lever.co/v0/postings/{board}?mode=json"
        ],
        "MinIntervalMinutes": 60
      },
      "ashby": {
        "Urls": [
          "https://api.ashbyhq.com/posting-api/job-board/{board}?includeCompensation=true"
        ],
        "MinIntervalMinutes": 60
      }
    }
  }
}
