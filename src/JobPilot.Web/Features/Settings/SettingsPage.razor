@page "/configuracion"
@using JobPilot.Web.Features.Mail

<PageTitle>Configuración · JobPilot</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Configuración</MudText>

<MudTabs Outlined="true" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4" ActivePanelIndex="@(Correo is not null ? 4 : Google is null ? 0 : 3)">
    <MudTabPanel Text="Conexión con Gemini">
        <GeminiConnectionPanel />
    </MudTabPanel>
    <MudTabPanel Text="Modelos por caso de uso">
        <UseCaseModelsPanel />
    </MudTabPanel>
    <MudTabPanel Text="Registro de llamadas">
        <LlmCallLogPanel />
    </MudTabPanel>
    <MudTabPanel Text="Google">
        <GooglePanel Result="@Google" Detail="@Detail" />
    </MudTabPanel>
    <MudTabPanel Text="Reglas de correo">
        <MailRulesPanel />
    </MudTabPanel>
    <MudTabPanel Text="Exportar / Importar">
        <JobPilot.Web.Features.Transfer.TransferPanel />
    </MudTabPanel>
</MudTabs>

@code {
    [SupplyParameterFromQuery(Name = "google")]
    public string? Google { get; set; }

    [SupplyParameterFromQuery(Name = "mensaje")]
    public string? Detail { get; set; }

    [SupplyParameterFromQuery(Name = "correo")]
    public string? Correo { get; set; }
}
