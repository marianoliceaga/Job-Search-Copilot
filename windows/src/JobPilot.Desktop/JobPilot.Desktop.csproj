<Project Sdk="Microsoft.NET.Sdk">

  <!-- Thin Windows host: a WPF window with WebView2 showing the web app, which runs as a child process on localhost. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the solution build (not run) on Linux, e.g. in the cloud container. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>JobSearchCopilot</AssemblyName>
    <RootNamespace>JobPilot.Desktop</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>JobSearch Copilot</Product>
    <AssemblyTitle>JobSearch Copilot</AssemblyTitle>
    <Description>JobSearch Copilot para Windows</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JobPilot.Desktop.Core\JobPilot.Desktop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
